title: "EAMENA Quick Pin"
message: "If you use this software, please cite it as below."
type: software
authors:
  - family-names: Ebrahimipour
    given-names: Salahaddin
    alias: "Salah Ebrahimipour"
    affiliation: "School of Archaeology, University of Oxford"
